{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
 "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "tvmaze-api", 
      "urls": ["https://api.tvmaze.com/**"],
      "cacheConfig": {
        "maxSize": 20,
        "maxAge": "1d",
        "strategy": "freshness"

      }
    }
  ],

  "assets": [
  "favicon.ico",
  "index.html",
  "manifest.webmanifest",
  "assets/**",
  "assets/i18n/*.json"
]
}
